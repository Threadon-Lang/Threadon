# Threadon random library
#
# A small deterministic pseudo-random generator, written entirely in Threadon.
# It is a linear congruential generator with a 31-bit state:
#
#     state = (state * 1103515245 + 12345) mod 2**31
#
# The multiplier and state fit in Int64, so the arithmetic is exact. The
# sequence is reproducible: calling seed() with the same value always gives
# the same stream. This is useful for tests, simulations and games, but it is
# NOT cryptographically secure and the default seed is fixed.
#
# The generator state lives in this module. Calls from different files share
# it, like any other module-level variable.

state: Int64 = 42

def seed(value: Int64) -> NoneType
    state = value % 2147483647
    if state <= 0:
        state = state + 2147483646
    return

def next_int() -> Int64
    state = (state * 1103515245 + 12345) % 2147483648
    return state

# Uniform integer in the inclusive range [lo, hi]. Reversed bounds are swapped.
def randint(lo: Int32, hi: Int32) -> Int32
    a: Int32 = lo
    b: Int32 = hi
    if a > b:
        a = b
        b = lo
    span: Int64 = Int64(b) - Int64(a) + 1
    return a + Int32(next_int() % span)

# Uniform Float64 in [0, 1).
def rand_float() -> Float64
    return Float64(next_int()) / 2147483648.0

def chance(percent: Int32) -> Bool
    if percent <= 0:
        return False
    if percent >= 100:
        return True
    return randint(1, 100) <= percent

def choice_int(xs: List[Int32]) -> Int32
    if len(xs) == 0:
        return 0
    i: Int32 = Int32(next_int() % Int64(len(xs)))
    return xs[i]

# Fisher-Yates shuffle of a COPY of xs.
def shuffle_int(xs: List[Int32]) -> List[Int32]
    out: List[Int32] = []
    i: Int32 = 0
    while i < Int32(len(xs)):
        out.append(xs[i])
        i += 1
    i = Int32(len(out)) - 1
    while i > 0:
        j: Int32 = Int32(next_int() % Int64(i + 1))
        tmp: Int32 = out[i]
        out[i] = out[j]
        out[j] = tmp
        i -= 1
    return out

# Roll a die with `sides` faces (1 through sides).
def dice(sides: Int32) -> Int32
    return randint(1, sides)
