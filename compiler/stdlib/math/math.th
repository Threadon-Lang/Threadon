# Threadon math library
#
# Pure Threadon, no external toolchain. Functions are grouped by the type they
# work on because Threadon has no overloading: `pow_int` takes Int32,
# `sqrt_f` takes Float64, and so on. Import what you need:
#
#   import math
#   from math import gcd, is_prime
#
# Every function is defined before it is used, following the usual Threadon
# rule. There are no module-level constants (only literal declarations are
# allowed at module level), so pi and e are small accessor functions.

# Absolute value for Int32. std.abs is auto-imported into main files only,
# so modules carry their own copy.
puredef iabs(n: Int32) -> Int32
    if n < 0:
        return -n
    return n

# Public abs name for programs that import math explicitly.
puredef abs(n: Int32) -> Int32
    return iabs(n)

# Integer power by repeated squaring. A negative exponent yields 0.
puredef pow_int(base: Int32, exp: Int32) -> Int32
    result: Int32 = 1
    b: Int32 = base
    e: Int32 = exp
    if e < 0:
        return 0
    while e > 0:
        if e % 2 == 1:
            result = result * b
        b = b * b
        e = e // 2
    return result

# n! as an Int64. n < 2 gives 1.
puredef factorial(n: Int32) -> Int64
    result: Int64 = 1
    i: Int32 = 2
    while i <= n:
        result = result * Int64(i)
        i += 1
    return result

# Greatest common divisor, always non-negative. gcd(0, 0) is 0.
puredef gcd(a: Int32, b: Int32) -> Int32
    x: Int32 = iabs(a)
    y: Int32 = iabs(b)
    while y != 0:
        t: Int32 = x % y
        x = y
        y = t
    return x

# Least common multiple, computed in Int64 to reduce the chance of wrapping.
puredef lcm(a: Int32, b: Int32) -> Int64
    if a == 0 or b == 0:
        return 0
    d: Int32 = gcd(a, b)
    return Int64(iabs(a) // d) * Int64(iabs(b))

# -1, 0, or 1 depending on the sign of n.
puredef sign(n: Int32) -> Int32
    if n < 0:
        return -1
    if n > 0:
        return 1
    return 0

# Trial-division primality test. Fine for modest Int32 values.
puredef is_prime(n: Int32) -> Bool
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    d: Int32 = 3
    while d * d <= n:
        if n % d == 0:
            return False
        d += 2
    return True

# Largest divisor of n not greater than its square root (0 for n < 1).
puredef integer_sqrt(n: Int32) -> Int32
    if n < 1:
        return 0
    r: Int32 = 1
    while (r + 1) * (r + 1) <= n:
        r += 1
    return r

# Truncate a Float64 towards zero.
puredef trunc_f(x: Float64) -> Int64
    return Int64(x)

# Floor: trunc for positive values, one less for negative non-integers.
puredef floor_f(x: Float64) -> Int64
    whole: Int64 = Int64(x)
    if x < 0.0:
        if Float64(whole) != x:
            return whole - 1
    return whole

# Ceiling: trunc for negative values, one more for positive non-integers.
puredef ceil_f(x: Float64) -> Int64
    whole: Int64 = Int64(x)
    if x > 0.0:
        if Float64(whole) != x:
            return whole + 1
    return whole

# Round half up. Negative halves round towards zero (e.g. -1.5 -> -1).
puredef round_f(x: Float64) -> Int64
    return floor_f(x + 0.5)

# Square root by Newton's method with a fixed number of iterations.
puredef sqrt_f(x: Float64) -> Float64
    if x <= 0.0:
        return 0.0
    g: Float64 = x
    if g < 1.0:
        g = 1.0
    i: Int32 = 0
    while i < 24:
        g = (g + x / g) / 2.0
        i += 1
    return g

# Hypotenuse of a right triangle, computed without overflowing on input squares.
puredef hypot_f(a: Float64, b: Float64) -> Float64
    x: Float64 = a
    y: Float64 = b
    if x < 0.0:
        x = -x
    if y < 0.0:
        y = -y
    return sqrt_f(x * x + y * y)

# pi and e as Float64 values.
puredef pi() -> Float64
    return 3.141592653589793

puredef e() -> Float64
    return 2.718281828459045

puredef to_radians(degrees: Float64) -> Float64
    return degrees * pi() / 180.0

puredef to_degrees(radians: Float64) -> Float64
    return radians * 180.0 / pi()

# Restrict a Float64 to [lo, hi].
puredef clamp_f(x: Float64, lo: Float64, hi: Float64) -> Float64
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

# Linear interpolation between a and b, with t normally in [0, 1].
puredef lerp_f(a: Float64, b: Float64, t: Float64) -> Float64
    return a + (b - a) * clamp_f(t, 0.0, 1.0)

# More math helpers. As everywhere in this module, names carry their type:
# `_f` works on Float64, the rest on Int32 unless stated otherwise.

puredef abs_f(x: Float64) -> Float64
    if x < 0.0:
        return -x
    return x

# Integer exponent. Negative exponents use a reciprocal; 0 ** negative is 0.
puredef pow_f(base: Float64, exp: Int32) -> Float64
    result: Float64 = 1.0
    b: Float64 = base
    e: Int32 = exp
    if e < 0:
        if b == 0.0:
            return 0.0
        e = -e
        result = 1.0 / pow_f(b, e)
        return result
    while e > 0:
        if e % 2 == 1:
            result = result * b
        b = b * b
        e = e // 2
    return result

# Floor of log base 2; -1 for n < 1.
puredef floor_log2(n: Int32) -> Int32
    if n < 1:
        return -1
    value: Int32 = 1
    power: Int32 = 0
    while value * 2 <= n:
        value = value * 2
        power += 1
    return power

# Fibonacci: fib(0) = 0, fib(1) = 1, n < 0 gives 0.
puredef fib(n: Int32) -> Int64
    if n < 1:
        return 0
    a: Int64 = 0
    b: Int64 = 1
    i: Int32 = 1
    while i < n:
        c: Int64 = a + b
        a = b
        b = c
        i += 1
    return b

puredef is_square(n: Int32) -> Bool
    if n < 0:
        return False
    r: Int32 = integer_sqrt(n)
    return r * r == n

# Number of positive divisors of n (0 for n < 1).
puredef divisor_count(n: Int32) -> Int32
    if n < 1:
        return 0
    count: Int32 = 0
    d: Int32 = 1
    while d * d <= n:
        if n % d == 0:
            count += 2
        d += 1
    last: Int32 = d - 1
    if last * last == n:
        count -= 1
    return count

# Sum of 1 .. n (0 for n < 1), computed in Int64.
puredef sum_to(n: Int32) -> Int64
    if n < 1:
        return 0
    return Int64(n) * Int64(n + 1) // 2

puredef avg_f(a: Float64, b: Float64) -> Float64
    return (a + b) / 2.0
