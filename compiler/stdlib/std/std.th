# Threadon standard library
#
# This module is imported automatically into every program; you never need
# to write `import std` yourself.  Its functions are available by their
# plain name, e.g. `clamp(n, 0, 100)`.
#
# The following runtime builtins are also always available:
#   print(a, b, ...) - print values (separated by spaces), then a newline
#   input(prompt) - show `prompt`, then read a line of text as a String
#  T(x) where T is a type

puredef abs(v: Int32) -> Int32
    if v < 0:
        return -v
    return v

puredef max(a: Int32, b: Int32) -> Int32
    if a > b:
        return a
    return b

puredef min(a: Int32, b: Int32) -> Int32
    if a < b:
        return a
    return b

puredef clamp(v: Int32, lo: Int32, hi: Int32) -> Int32
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

puredef is_even(n: Int32) -> Bool
    return n % 2 == 0

puredef is_odd(n: Int32) -> Bool
    return n % 2 != 0

class Iterable:
    _cur: Int64
    _step: Int64
    _stop: Int64
    _done: Bool

    puredef __init__(self: Iterable, cur: Int64, step: Int64, stop: Int64, done: Bool)
        self._cur = cur
        self._step = step
        self._stop = stop
        self._done = done

    puredef done(self: Iterable) -> Bool
        return self._done

    puredef value(self: Iterable) -> Int64
        return self._cur

    puredef advance(self: Iterable) -> Iterable
        n: Int64 = self._cur + self._step
        d: Bool = False
        if self._step > 0:
            if n >= self._stop:
                d = True
        if self._step < 0:
            if n <= self._stop:
                d = True
        if self._step == 0:
            d = True
        return Iterable(n, self._step, self._stop, d)

puredef range(start: Int64, stop: Int64, step: Int64) -> Iterable
    d: Bool = False
    if step > 0:
        if start >= stop:
            d = True
    if step < 0:
        if start <= stop:
            d = True
    if step == 0:
        d = True
    return Iterable(start, step, stop, d)

# Int64 variants of the small numeric helpers above. The suffixes keep these
# names from colliding with functions in the opt-in modules.
puredef abs_i64(v: Int64) -> Int64
    if v < 0:
        return -v
    return v

puredef max_i64(a: Int64, b: Int64) -> Int64
    if a > b:
        return a
    return b

puredef min_i64(a: Int64, b: Int64) -> Int64
    if a < b:
        return a
    return b

puredef clamp_i64(v: Int64, lo: Int64, hi: Int64) -> Int64
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

# Inclusive range check and divisibility (k == 0 is never a multiple).
puredef between(v: Int32, lo: Int32, hi: Int32) -> Bool
    if v < lo:
        return False
    if v > hi:
        return False
    return True

puredef is_multiple(n: Int32, k: Int32) -> Bool
    if k == 0:
        return False
    return n % k == 0

# Integer square and absolute difference. square returns Int64 to give the
# result a little more headroom before wrapping.
puredef square_int(v: Int32) -> Int64
    return Int64(v) * Int64(v)

puredef diff_int(a: Int32, b: Int32) -> Int32
    if a < b:
        return b - a
    return a - b
