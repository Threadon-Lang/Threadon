# Threadon standard library
#
# This module is imported automatically into every program; you never need
# to write `import std` yourself.  Its functions are available by their
# plain name, e.g. `clamp(n, 0, 100)`.
#
# The following runtime builtins are also always available:
#   print(a, b, ...) - print values (separated by spaces), then a newline
#   input(prompt) - show `prompt`, then read a line of text as a String
#  T(x) where T is a type

def abs(x: Int32) -> Int32
    if x < 0:
        return -x
    return x

def max(a: Int32, b: Int32) -> Int32
    if a > b:
        return a
    return b

def min(a: Int32, b: Int32) -> Int32
    if a < b:
        return a
    return b

def clamp(x: Int32, lo: Int32, hi: Int32) -> Int32
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

def is_even(n: Int32) -> Bool
    return n % 2 == 0

def is_odd(n: Int32) -> Bool
    return n % 2 != 0

class Iterable:
    _cur: Int
    _step: Int
    _stop: Int
    _done: Bool

    def __init__(self: Iterable, cur: Int, step: Int, stop: Int, done: Bool)
        self._cur = cur
        self._step = step
        self._stop = stop
        self._done = done

    def done(self: Iterable) -> Bool
        return self._done

    def value(self: Iterable) -> Int
        return self._cur

    def advance(self: Iterable) -> Iterable
        n: Int = self._cur + self._step
        d: Bool = False
        if self._step > 0:
            if n >= self._stop:
                d = True
        if self._step < 0:
            if n <= self._stop:
                d = True
        if self._step == 0:
            d = True
        return Iterable(n, self._step, self._stop, d)

def range(start: Int, stop: Int, step: Int) -> Iterable
    d: Bool = False
    if step > 0:
        if start >= stop:
            d = True
    if step < 0:
        if start <= stop:
            d = True
    if step == 0:
        d = True
    return Iterable(start, step, stop, d)
