def abs(x: Int32) -> Int32
    result: Int32 = x
    if x < 0:
        result *= -1
    return result

def clamp(n: Int32, lo: Int32, hi: Int32) -> Int32
    if n < lo:
        result: Int32 = lo
    elif n > hi:
        result: Int32 = hi
    else:
        result: Int32 = n
    return result

def mean(a: Float32, b: Float32) -> Float32
    return (a + b) / 2.0
